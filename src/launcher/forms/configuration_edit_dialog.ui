          <item row="1" column="0">
           <widget class="QLabel" name="label_shader_cache_enabled">
            <property name="text"><string>Persistent shader cache:</string></property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QCheckBox" name="checkBox_shader_cache_enabled">
            <property name="toolTip"><string>Save and reuse compiled Vulkan pipelines (_PipelineCache/&lt;game&gt;.bin). Removes most first-run shader stutter. Disable only to reproduce shader-related bugs.</string></property>
            <property name="text"><string/>
            </property>
            <property name="checked"><bool>true</bool></property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="label_shader_cache_async_save">
            <property name="text"><string>Crash-safe cache checkpoints:</string></property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QCheckBox" name="checkBox_shader_cache_async_save">
            <property name="toolTip"><string>Every 2 minutes the compiled pipeline cache is checkpointed to disk from a background thread. If the game crashes you keep all shaders compiled so far instead of starting cold on the next run.</string></property>
            <property name="text"><string/>
            </property>
            <property name="checked"><bool>true</bool></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="shader_log_group">
         <property name="title"><string>Shader logging</string></property>
         <layout class="QFormLayout" name="shaderLogLayout">
          <property name="fieldGrowthPolicy">
           <enum>QFormLayout::AllNonFixedFieldsGrow</enum>
          </property>
          <item row="0" column="0">
           <widget class="QLabel" name="label_shader_log_direction">
            <property name="text"><string>Shader logging:</string></property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="comboBox_shader_log_direction">
            <property name="toolTip"><string>Dump shaders to file or console window. If enabled may decrease emulator performance</string></property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="label_shader_log_folder">
            <property name="text"><string>Shader log folder:</string></property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="MandatoryLineEdit" name="lineEdit_shader_log_folder">
            <property name="toolTip"><string>Specify directory to dump shaders</string></property>
            <property name="clearButtonEnabled"><bool>true</bool></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <spacer name="shadersSpacer">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
         <property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="debug_tab">
      <attribute name="title"><string>Debug</string></attribute>
      <layout class="QVBoxLayout" name="debugTabLayout">
       <item>
        <widget class="QGroupBox" name="debug_group">
         <property name="title">
          <string>Debugging &amp;&amp; logs</string>
         </property>
         <layout class="QGridLayout" name="debugLayout" columnstretch="0,1,0,1">
          <property name="horizontalSpacing"><number>8</number></property>
          <property name="verticalSpacing"><number>6</number></property>
          <item row="0" column="0" colspan="2">
           <widget class="QCheckBox" name="checkBox_vulkan_validation">
            <property name="toolTip"><string>Enable Vulkan validation layers</string></property>
            <property name="text"><string>Vulkan validation</string></property>
            <property name="checked"><bool>true</bool></property>
           </widget>
          </item>
          <item row="0" column="2" colspan="2">
           <widget class="QCheckBox" name="checkBox_shader_validation">
            <property name="toolTip"><string>Validate SPIR-V binary</string></property>
            <property name="text"><string>Shader validation</string></property>
            <property name="checked"><bool>true</bool></property>
           </widget>
          </item>
          <item row="1" column="0" colspan="2">
           <widget class="QCheckBox" name="checkBox_gpu_assisted_validation">
            <property name="toolTip"><string>Bounds-check shader memory accesses on the GPU. Implies Vulkan validation; very slow.</string></property>
            <property name="text"><string>GPU-assisted validation</string></property>
           </widget>
          </item>
          <item row="1" column="2" colspan="2">
           <widget class="QCheckBox" name="checkBox_renderdoc_capture">
            <property name="toolTip"><string>Enable RenderDoc capture</string></property>
            <property name="text"><string>RenderDoc capture</string></property>
           </widget>
          </item>
          <item row="2" column="0" colspan="2">
           <widget class="QCheckBox" name="checkBox_cmd_dump">
            <property name="toolTip"><string>Dump command buffers</string></property>
            <property name="text"><string>Command buffer dump</string></property>
           </widget>
          </item>
          <item row="2" column="2" colspan="2">
           <widget class="QCheckBox" name="checkBox_graphics_debug_dump">
            <property name="toolTip"><string>Enable graphics debug dumps</string></property>
            <property name="text"><string>Graphics debug dump</string></property>
           </widget>
          </item>
          <item row="3" column="0" colspan="2">
           <widget class="QCheckBox" name="checkBox_spirv_debug_printf">
            <property name="toolTip"><string>Enable SPIR-V debug printf (non-Release shader builds).</string></property>
            <property name="text"><string>SPIR-V debug printf</string></property>
           </widget>
          </item>
          <item row="3" column="2" colspan="2">
           <widget class="QCheckBox" name="checkBox_profiler">
            <property name="toolTip"><string>Enable the Tracy profiler. Profiling may decrease emulator performance</string></property>
            <property name="text"><string>Tracy profiler</string></property>
           </widget>
          </item>
          <item row="4" column="0">
           <widget class="QLabel" name="label_printf_direction">
            <property name="text"><string>Printf output:</string></property>
           </widget>
          </item>
          <item row="4" column="1">
           <widget class="QComboBox" name="comboBox_printf_direction">
            <property name="toolTip"><string>Print logs to file or console window. If enabled may decrease emulator performance</string></property>
           </widget>
          </item>
          <item row="4" column="2">
           <widget class="QLabel" name="label_printf_file">
            <property name="text"><string>Printf output file:</string></property>
           </widget>
          </item>
          <item row="4" column="3">
           <widget class="MandatoryLineEdit" name="lineEdit_printf_file">
            <property name="toolTip"><string>Specify file to dump logs</string></property>
            <property name="clearButtonEnabled"><bool>true</bool></property>
           </widget>
          </item>
          <item row="5" column="2">
           <widget class="QLabel" name="label_cmd_dump_folder">
            <property name="text"><string>Command buffer folder:</string></property>
           </widget>
          </item>
          <item row="5" column="3">
           <widget class="MandatoryLineEdit" name="lineEdit_cmd_dump_folder">
            <property name="toolTip"><string>Specify directory to dump command buffers</string></property>
            <property name="clearButtonEnabled"><bool>true</bool></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="advanced_group">
         <property name="title"><string>Advanced</string></property>
         <layout class="QFormLayout" name="advancedLayout">
          <property name="fieldGrowthPolicy">
           <enum>QFormLayout::AllNonFixedFieldsGrow</enum>
          </property>
          <item row="0" column="0">
           <widget class="QLabel" name="label_thread_affinity">
            <property name="text"><string>CPU cores:</string></property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QLineEdit" name="lineEdit_thread_affinity">
            <property name="toolTip"><string>Restrict the emulator to specific CPU cores, e.g. 0-7 or 0,2,4. Empty uses all cores. Helps performance on hybrid CPUs (P/E cores).</string></property>
            <property name="clearButtonEnabled"><bool>true</bool></property>
            <property name="placeholderText"><string>All cores</string></property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="label_vr_enabled">
            <property name="text"><string>Virtual VR headset:</string></property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QCheckBox" name="checkBox_vr_enabled">
            <property name="toolTip"><string>Enable the virtual VR headset (PS VR games).</string></property>
            <property name="text"><string/>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="label_playgo_hack">
            <property name="text"><string>PlayGo stub fallback:</string></property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QCheckBox" name="checkBox_playgo_hack">
            <property name="toolTip"><string>Use the supplied PlayGo stub fallback for games that wait on streaming data.</string></property>
            <property name="text"><string/>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <spacer name="debugSpacer">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
         <property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property>
        </spacer>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="buttonLayout">
     <item>
     <widget class="QPushButton" name="clear_button">
       <property name="minimumSize"><size><width>80</width><height>25</height></size></property>
       <property name="text"><string>Reset</string></property>
       <property name="toolTip"><string>Restore default settings</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="settings_button">
       <property name="minimumSize"><size><width>80</width><height>25</height></size></property>
       <property name="text"><string>Game Configs</string></property>
       <property name="toolTip"><string>Import or export game configs</string></property>
      </widget>
     </item>
     <item>
      <spacer name="buttonSpacer">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="cancel_button">
       <property name="minimumSize"><size><width>80</width><height>25</height></size></property>
       <property name="text"><string>Cancel</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="ok_button">
       <property name="minimumSize"><size><width>80</width><height>25</height></size></property>
       <property name="text"><string>Save</string></property>
       <property name="default"><bool>true</bool></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
 <customwidgets>
  <customwidget>
   <class>MandatoryLineEdit</class>
   <extends>QLineEdit</extends>
   <header>mandatoryLineEdit.h</header>
  </customwidget>
 </customwidgets>
