          </property>
          <item row="0" column="0">
           <widget class="QLabel" name="label_vblank_frequency">
            <property name="text"><string>Vblank frequency:</string></property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QSpinBox" name="spinBox_vblank_frequency">
            <property name="toolTip"><string>Virtual display refresh rate used for frame pacing</string></property>
            <property name="minimum"><number>30</number></property>
            <property name="maximum"><number>360</number></property>
            <property name="value"><number>60</number></property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="label_vblank_catchup">
            <property name="text"><string>Vblank catch-up:</string></property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QCheckBox" name="checkBox_vblank_catchup_enabled">
            <property name="toolTip"><string>Fire additional vblank events when host FPS drops below the target. Prevents slow motion at the cost of choppy visuals.</string></property>
            <property name="text"><string/>
            </property>
            <property name="checked"><bool>true</bool></property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="label_speed_2x">
            <property name="text"><string>2x speed (fast-forward):</string></property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QCheckBox" name="checkBox_speed_2x_enabled">
            <property name="toolTip"><string>Run game logic at 2x speed (PPSSPP-style fast-forward). Game runs at 200% speed.</string></property>
            <property name="text"><string/>
            </property>
            <property name="checked"><bool>false</bool></property>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QLabel" name="label_frame_skip">
            <property name="text"><string>Frame skip count:</string></property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QSpinBox" name="spinBox_frame_skip_count">
            <property name="toolTip"><string>Max vblanks fired per rendered frame. 1 = no extra skip (just catch-up). Higher = more aggressive skip on slow GPUs.</string></property>
