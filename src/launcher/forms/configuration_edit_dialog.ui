           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="comboBox_upscaling_filter">
            <property name="toolTip"><string>Filter applied when the window is bigger than the guest render target. fsr = AMD FidelityFX Super Resolution 1.0 (edge adaptive), scaleforce = ScaleForce (edge directed), bicubic = Catmull-Rom, integer = pixel perfect.</string></property>
            <item><property name="text"><string>bilinear</string></property></item>
            <item><property name="text"><string>nearest</string></property></item>
            <item><property name="text"><string>bicubic</string></property></item>
            <item><property name="text"><string>integer</string></property></item>
            <item><property name="text"><string>fsr</string></property></item>
            <item><property name="text"><string>scaleforce</string></property></item>
