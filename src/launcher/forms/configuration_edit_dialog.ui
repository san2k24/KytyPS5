              <property name="minimumSize"><size><width>40</width><height>0</height></size></property>
              <property name="text"><string>80%</string></property>
             </widget>
            </item>
           </layout>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="label_texture_filtering">
            <property name="text"><string>Texture filtering:</string></property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QComboBox" name="comboBox_texture_filtering">
            <property name="toolTip"><string>game keeps the exact sampler state programmed by the game (faithful). force_af upgrades bilinear samplers to 16x anisotropic filtering for crisper textures at oblique angles (visual only).</string></property>
            <item><property name="text"><string>game</string></property></item>
            <item><property name="text"><string>force_af</string></property></item>
           </widget>
          </item>
