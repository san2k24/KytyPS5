            <property name="text"><string>RCAS sharpening:</string></property>
           </widget>
          </item>
          <item row="1" column="1">
           <layout class="QHBoxLayout" name="upscaleSharpnessLayout">
            <item>
             <widget class="QSlider" name="slider_upscale_sharpness">
              <property name="toolTip"><string>AMD FidelityFX RCAS contrast-adaptive sharpening applied after the fsr, scaleforce or bicubic upscaling filter. 0% disables the sharpening pass; higher values are sharper (may over-sharpen halos at 100%).</string></property>
              <property name="minimum"><number>0</number></property>
              <property name="maximum"><number>100</number></property>
              <property name="value"><number>80</number></property>
              <property name="orientation"><enum>Qt::Horizontal</enum></property>
